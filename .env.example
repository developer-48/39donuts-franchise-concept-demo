# Режим задают npm-команды через scripts/astro-command.mjs:
# dev / build:preview / preview -> preview (noindex, dist-preview для сборки)
# build / preview:production -> production (dist)
# PUBLIC_SITE_MODE в .env или окружении не переопределяет эти команды.
#
# Домен по умолчанию: https://39donuts.ru/
# SITE_URL читается astro.config.mjs из окружения команды, не из этого файла:
# SITE_URL=https://39donuts.ru npm run build
# Допустим только HTTPS origin без подпапки, параметров и якоря.
#
# Токены Telegram и прочие серверные секреты здесь для браузера не задаются.

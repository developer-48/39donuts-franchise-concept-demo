# Apache 2.4. Upload this hidden file together with the production dist contents.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.39donuts\.ru(?::[0-9]+)?$ [NC]
  RewriteRule ^ https://39donuts.ru%{REQUEST_URI} [R=301,L,NE]

  # For TLS-terminating proxies, the host must set HTTPS correctly here.
  RewriteCond %{HTTP_HOST} ^39donuts\.ru(?::[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://39donuts.ru%{REQUEST_URI} [R=301,L,NE]

  RewriteRule ^(?:e|f|g)(?:/index\.html)?/?$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

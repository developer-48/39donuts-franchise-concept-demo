---
import { reviews } from '../data/siteContent.js'
import BrandText from '../components/BrandText.astro'
---
<section class="section reviews-section reveal" id="reviews" aria-labelledby="reviews-title">
  <div class="section-shell">
    <div class="section-heading split-heading section-heading-solo">
      <div>
        <span class="eyebrow">Голоса партнёров</span>
        <h2 id="reviews-title">Отзывы из сети</h2>
      </div>
    </div>
    <div class="reviews-grid">
      {reviews.map((review, index) => (
        <article class="review-card motion-item">
          <div class="review-photo">
            <img src={review.image} alt={`${review.name}, партнёр из города ${review.city}`} />
            <span>0{index + 1}</span>
          </div>
          <blockquote>
            <p><BrandText text={review.text} /></p>
            <footer>
              <strong>{review.name}</strong>
              <span>{review.city}</span>
            </footer>
          </blockquote>
        </article>
      ))}
    </div>
  </div>
</section>

---
import { heroMetrics, assets } from '../data/siteContent.js'
import BrandText from '../components/BrandText.astro'
import Icon from '../components/Icon.astro'
---
<section class="hero-section" id="top" aria-labelledby="hero-title">
  <div class="hero-canvas section-shell">
    <div class="hero-copy">
      <span class="eyebrow">Франшиза кофеен с пончиками</span>
      <h1 id="hero-title">
        Маленькая точка.<br />Большая амбиция.
      </h1>
      <p class="hero-lede">
        <BrandText text="39 donuts выросли из первой кофейни площадью 39 м² — и продолжают двигаться от локальной идеи к мировой сети." />
      </p>
      <div class="hero-origin-inline">
        <span>Первая идея</span>
        <strong><BrandText text="39 м²" /></strong>
        <small>старт сети · 2023</small>
      </div>
      <div class="hero-actions">
        <button class="button" type="button" data-open-application>
          Купить франшизу
          <img class="button-pack-icon" src={`${import.meta.env.BASE_URL}assets/icons/shop.svg`} alt="" aria-hidden="true" />
        </button>
        <a class="text-link" href="#revenue">
          Смотреть показатели
          <Icon name="SolidArrowRight" />
        </a>
      </div>
    </div>

    <div class="hero-media">
      <img class="hero-photo" src={assets.hero} alt="" />
      <img class="hero-donut" src={assets.donut} alt="" />
      <div class="hero-origin-proof">
        <span>Первая идея</span>
        <strong><BrandText text="39 м²" /></strong>
        <small>старт сети · 2023</small>
      </div>
    </div>

    <div class="hero-metrics" aria-label="Ключевые показатели франшизы">
      {heroMetrics.map((metric, index) => (
        <article>
          <span>0{index + 1}</span>
          <strong>{metric.value}</strong>
          <p>{metric.label}</p>
        </article>
      ))}
    </div>
  </div>
</section>

---
import SiteImage from '../components/SiteImage.astro'
import { assets, steps } from '../data/siteContent.js'
import Icon from '../components/Icon.astro'
---
<section class="section partnership-section reveal" id="application" aria-labelledby="partnership-title">
  <div class="section-shell">
    <div class="partnership-topline">
      <span class="eyebrow">Путь к открытию</span>
      <h2 id="partnership-title">5 шагов к партнёрству</h2>
    </div>
    <ol class="steps-list motion-trigger">
      {steps.map((step, index) => (
        <li class="motion-item">
          <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>
    <div class="application-callout">
      <div class="application-copy">
        <h3>Анкета — первый шаг к знакомству</h3>
        <button class="button" type="button" data-open-application>
          Заполнить анкету
          <Icon name="SolidArrowRight" />
        </button>
      </div>
      <SiteImage src={assets.application} alt="Иллюстративная композиция: телефон, стакан и пончик 39 donuts" />
    </div>
  </div>
</section>

---
import { advantages, assets, network } from '../data/siteContent.js'
import BrandText from '../components/BrandText.astro'
---
<section class="section network-section reveal" id="network" aria-labelledby="network-title">
  <div class="section-shell">
    <div class="network-intro">
      <div>
        <span class="eyebrow">География роста</span>
        <h2 id="network-title">Сколько нас</h2>
      </div>
      <p><BrandText text="За два года 39 donuts открыли больше 19 точек и продолжают расти. Текущий сайт отдельно показывает такую разбивку сети:" /></p>
    </div>

    <div class="network-proof">
      <div class="country-list">
        {network.map((item) => (
          <article class="motion-trigger">
            <strong><span class="network-count-value">{item.count}</span></strong>
            <span>{item.count === '1' ? 'точка' : 'точек'}</span>
            <p>{item.country}</p>
          </article>
        ))}
      </div>
      <div class="shop-mosaic">
        <figure class="motion-item">
          <img src={assets.shopCounter} alt="Витрина с пончиками в кофейне" />
          <figcaption>Россия · витрина</figcaption>
        </figure>
        <figure class="motion-item">
          <img src={assets.shopInterior} alt="Интерьер кофейни с открытой витриной" />
          <figcaption>Россия · интерьер</figcaption>
        </figure>
        <figure class="motion-item">
          <img src={assets.shopCase} alt="Кофейня с витриной и фирменной вывеской" />
          <figcaption>Казахстан · формат сети</figcaption>
        </figure>
      </div>
    </div>

    <div class="advantages-showcase">
      <article class="advantages-feature">
        <div class="advantages-feature-copy">
          <span class="eyebrow">Продукт как бизнес</span>
          <h3>Почему пончики?</h3>
          <p>Знакомый эмоциональный продукт превращается в компактную и масштабируемую бизнес-модель.</p>
        </div>
        <img class="motion-item" src={assets.donut} alt="Фирменный пончик 39 donuts" />
        <span class="advantages-feature-note">Вкус, который легко узнать</span>
      </article>
      <div class="advantages-cards">
        {advantages.map((item) => (
          <article class="motion-item">
            <span class="advantage-number">{item.number}</span>
            <div>
              <h4>{item.title}</h4>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

---
import BrandText from '../../components/BrandText.astro'
import Icon from '../../components/Icon.astro'
import WizardField from './WizardField.astro'
import WizardRadioGroup from './WizardRadioGroup.astro'
import WizardTextArea from './WizardTextArea.astro'
import { applicationSteps, roleOptions, formatOptions, investmentOptions } from '../../data/applicationContent.js'
---
<div class="dialog-layer application-wizard-layer application-wizard-layer-current" data-dialog-state="open" hidden>
  <button class="dialog-backdrop" type="button" aria-label="Закрыть анкету" data-close-application></button>
  <div class="application-dialog application-wizard application-wizard-current" role="dialog" aria-modal="true" aria-labelledby="application-wizard-title" aria-describedby="application-wizard-description">
    <div class="wizard-topbar">
      <div>
        <span class="dialog-kicker">Заявка на партнёрство</span>
        <h2 id="application-wizard-title">Анкета партнёра <BrandText text="39 donuts" /></h2>
        <p id="application-wizard-description">Четыре коротких шага: расскажите о себе, проекте и планах запуска.</p>
      </div>
      <button class="dialog-close" type="button" aria-label="Закрыть анкету" data-close-application><Icon name="XMarkSolid" /></button>
    </div>
    <div class="demo-success wizard-success" role="status" aria-live="polite" hidden>
      <span><Icon name="Check" /></span><h3>Анкета готова</h3>
      <p>Ответы собраны. Можно вернуться к анкете, изменить любой раздел и отправить её снова.</p>
      <div class="wizard-success-actions">
        <button class="button" type="button" data-return-answers>Вернуться к ответам</button>
        <button class="wizard-back" type="button" data-reset-application>Заполнить заново</button>
      </div>
    </div>
    <div class="wizard-layout">
      <aside class="wizard-progress" aria-label="Этапы анкеты">
        <span aria-live="polite" data-step-status>Шаг 1 из 4</span>
        <ol>{applicationSteps.map((item, index) => (
          <li class={index === 0 ? 'is-active' : ''}>
            <button class="wizard-progress-step" type="button" disabled={index !== 0} aria-current={index === 0 ? 'step' : undefined}
              aria-label={`Шаг ${index + 1}: ${item.title}. ${index === 0 ? 'Текущий шаг.' : 'Сначала заполните предыдущие шаги.'}`} data-wizard-step={index}>
              <span>{String(index + 1).padStart(2, '0')}</span><div><strong>{item.title}</strong><small>{item.copy}</small></div>
            </button>
          </li>
        ))}</ol>
      </aside>
      <form class="wizard-form" novalidate>
        <div class="wizard-step-heading"><span data-step-number>01 / 04</span><h3 tabindex="-1">О вас</h3><p>{applicationSteps[0].copy}</p></div>
        <div class="wizard-step-body" data-step-body="0">
          <div class="form-grid two-columns">
            <WizardField label="ФИО" name="fullName" placeholder="Иванов Иван Иванович" required />
            <WizardField label="Возраст" name="age" placeholder="30" inputMode="numeric" />
          </div>
          <WizardField label="Опыт работы" name="experience" placeholder="Например, 3 года в общепите" />
          <WizardRadioGroup label="Какую роль планируете занять?" name="role" options={roleOptions} />
        </div>
        <div class="wizard-step-body" data-step-body="1" hidden>
          <div class="form-grid two-columns form-group-grid">
            <WizardRadioGroup label="Какой формат хотите открыть?" name="format" options={formatOptions} />
            <WizardRadioGroup label="Как планируете инвестировать?" name="investment" options={investmentOptions} />
          </div>
          <WizardField label="Регион / город / место" name="region" placeholder="Город, район или торговый центр" required />
        </div>
        <div class="wizard-step-body" data-step-body="2" hidden>
          <div class="form-grid two-columns">
            <WizardTextArea label="Маркетинговая стратегия" name="marketing" placeholder="Как планируете привлекать гостей?" />
            <WizardTextArea label="Почему 39 donuts" name="reason" placeholder="Что привлекло вас в бренде?" />
          </div>
          <WizardTextArea label="О себе" name="about" placeholder="Коротко расскажите о себе" />
        </div>
        <div class="wizard-step-body" data-step-body="3" hidden>
          <WizardField label="Контакт" name="contact" placeholder="Телефон / Telegram / Email" required />
          <div class="wizard-review" aria-label="Все ответы анкеты">
            <div class="wizard-review-heading"><div><span>Ваши ответы</span><p>Проверьте заполненные данные перед отправкой. Каждый раздел можно открыть и изменить.</p></div></div>
            <div class="wizard-review-groups"></div>
          </div>
          <p class="wizard-privacy-note">Нажимая «Отправить заявку», вы соглашаетесь с <a href="https://39donuts.ru/privacy-policy/" target="_blank" rel="noreferrer">политикой обработки персональных данных</a>.</p>
        </div>
        <div class="wizard-actions">
          <p>К предыдущим шагам можно вернуться без потери ответов.</p>
          <div>
            <button class="wizard-back" type="button" data-wizard-back hidden><Icon name="SolidArrowLeft" class="wizard-action-icon" /><span>Назад</span></button>
            <button class="button" type="submit"><span data-submit-label>Продолжить</span> <Icon name="SolidArrowRight" class="wizard-action-icon" /></button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

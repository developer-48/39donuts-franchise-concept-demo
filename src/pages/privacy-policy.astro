---
import BaseLayout from '../layouts/BaseLayout.astro'
import { assets } from '../data/siteContent.js'
import { privacyHtml } from '../data/privacyContent.js'
---
<BaseLayout title="Политика обработки персональных данных — 39 donuts" description="Политика обработки и защиты персональных данных пользователей сайта 39 donuts. Сведения об операторе, целях обработки и правах пользователя." interactive={false}>
  <header class="legal-header"><a href="/" aria-label="39 donuts — на главную"><img src={assets.logo} width="193.5" height="36" alt="39 donuts" /></a><a href="/">На главную</a></header>
  <main class="legal-document" set:html={privacyHtml} />
</BaseLayout>
<style>
  .legal-header{max-width:960px;margin:0 auto;padding:28px 24px;display:flex;gap:24px;align-items:center;justify-content:space-between;border-bottom:1px solid #ded9e3}
  .legal-header>a{color:#7a44ca;font-weight:700}
  .legal-document{max-width:960px;margin:0 auto;padding:40px 24px 80px;line-height:1.75;color:#302738;overflow-wrap:anywhere}
  .legal-document :global(h1){font-size:clamp(30px,5vw,52px);line-height:1.15;margin:12px 0 30px}
  .legal-document :global(h2){font-size:clamp(21px,3vw,27px);line-height:1.3;margin:36px 0 16px}
  .legal-document :global(p),.legal-document :global(ul){margin:0 0 16px}
  .legal-document :global(ul){padding-left:24px;list-style:disc}
  .legal-document :global(li){margin-bottom:8px}
  .legal-document :global(a){color:#7a44ca;text-decoration:underline}
</style>

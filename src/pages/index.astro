---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/layout/header/Header.astro'
import FormatsSection from '../components/sections/formats/FormatsSection.astro'
import FaqSection from '../components/sections/faq/FaqSection.astro'
import ApplicationWizardDialog from '../components/application/ApplicationWizardDialog.astro'
import HeroSection from '../components/sections/hero/HeroSection.astro'
import RevenueSection from '../components/sections/revenue/RevenueSection.astro'
import StorySection from '../components/sections/story/StorySection.astro'
import NetworkSection from '../components/sections/network/NetworkSection.astro'
import ReviewsSection from '../components/sections/reviews/ReviewsSection.astro'
import PartnershipSection from '../components/sections/partnership/PartnershipSection.astro'
import ContactSection from '../components/sections/contacts/ContactSection.astro'
import SiteFooter from '../components/layout/footer/SiteFooter.astro'
// Shared layout CSS is loaded first; section rules follow it in the cascade.
import '../styles/landing.css'
---

<BaseLayout>
  <div class="site">
    <a class="skip-link" href="#main-content">
      Перейти к содержанию
    </a>
    <Header />
    <main id="main-content">
      <HeroSection />
      <RevenueSection />
      <StorySection />
      <NetworkSection />
      <FormatsSection />
      <ReviewsSection />
      <PartnershipSection />
      <FaqSection />
      <ContactSection />
    </main>
    <SiteFooter />
    <ApplicationWizardDialog />
  </div>
</BaseLayout>

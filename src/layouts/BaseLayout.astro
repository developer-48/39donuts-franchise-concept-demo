---
import '../styles/index.css'
import DonutScrollbar from '../features/navigation/DonutScrollbar.astro'
const { title = '39 donuts — франшиза кофеен с пончиками' } = Astro.props
const production = import.meta.env.PUBLIC_SITE_MODE === 'production'
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fffaf3" />
    {!production && <meta name="robots" content="noindex, nofollow" />}
    {production && Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico?favicon.f364ab3d.ico`} sizes="256x256" type="image/x-icon" />
    <meta name="description" content="Концепт редизайна сайта франшизы 39 donuts: история бренда, показатели сети, форматы кофеен, отзывы, FAQ и анкета партнёра." />
    <title>{title}</title>
    <noscript><style>.reveal,.motion-item,.motion-trigger,.network-count-value{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body>
    <div id="root"><slot /></div>
    <DonutScrollbar />
    <script>
      import '../scripts/site.js'
    </script>
  </body>
</html>

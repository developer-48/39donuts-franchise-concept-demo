---
const { label, name, placeholder, required = false, inputMode = 'text' } = Astro.props
---

<label class="form-field">
  <span>
    {label} {required && <b aria-hidden="true">*</b>}
  </span>
  <input
    name={name}
    type="text"
    inputmode={inputMode}
    placeholder={placeholder}
    required={required}
    aria-invalid="false"
  />
</label>

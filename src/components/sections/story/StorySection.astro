---
import SiteImage from '../../ui/image/SiteImage.astro'
import { assets } from '../../../config/assets.js'
import { story } from './content.js'
import BrandText from '../../ui/brand/BrandText.astro'
import FounderGallery from './gallery/FounderGallery.astro'
---

<section class="section story-section reveal" id="story" aria-labelledby="story-title">
  <div class="section-shell">
    <div class="story-origin">
      <div class="story-origin-copy">
        <span class="eyebrow">Глава 01 · Начало</span>
        <h2 id="story-title">
          История, которая началась{' '}
          <span class="nowrap">
            с <BrandText text="39 м²" />
          </span>
        </h2>
        <p>
          <BrandText text={story.origin} />
        </p>
        <div class="origin-equation" aria-label="От 39 квадратных метров к бесконечному росту">
          <strong>
            <BrandText text="39 м²" />
          </strong>
          <svg class="origin-equation-arrow" viewBox="0 0 68 40" fill="none" aria-hidden="true">
            <path
              d="M3 20H61M43 3L61 20L43 37"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <strong>∞</strong>
        </div>
      </div>
      <FounderGallery />
    </div>

    <div class="story-grid">
      <article class="story-card story-mission motion-item">
        <span class="story-number">02</span>
        <h3>Смысл бренда</h3>
        <p>
          <BrandText text={story.mission} />
        </p>
        <div class="story-photo-pair" aria-hidden="true">
          <SiteImage src={assets.crowd} alt="" />
          <SiteImage src={assets.kioskNight} alt="" />
        </div>
      </article>
      <article class="story-card story-recipe motion-item">
        <span class="story-number">03</span>
        <div>
          <h3>Секрет — во вкусе</h3>
          <p>{story.recipe}</p>
        </div>
        <SiteImage src={assets.donut} alt="Фирменный пончик с шоколадной глазурью" />
      </article>
      <article class="story-card story-growth motion-item">
        <span class="story-number">04</span>
        <SiteImage src={assets.founders} alt="Ибрагим Токкаев и Джамбулат Исмаилов" />
        <div>
          <h3>Усиление команды</h3>
          <p>
            <BrandText text={story.partnership} />
          </p>
        </div>
      </article>
      <article class="story-card story-counter motion-item">
        <span class="story-number">05</span>
        <div class="story-counter-copy">
          <strong>{story.donutsSold}</strong>
          <p>{story.donutsSoldLabel}</p>
        </div>
        <SiteImage class="story-counter-ribbon" src={assets.donutRibbon} alt="" />
      </article>
    </div>
  </div>
</section>

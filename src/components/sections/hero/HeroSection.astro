---
import Button from '../../ui/button/Button.astro'
import SiteImage from '../../ui/image/SiteImage.astro'
import { heroMetrics } from './content.js'
import { assets } from '../../../config/assets.js'
import BrandText from '../../ui/brand/BrandText.astro'
import Icon from '../../ui/icon/Icon.astro'
---

<section class="hero-section" id="top" aria-labelledby="hero-title">
  <div class="hero-canvas section-shell">
    <div class="hero-copy">
      <span class="eyebrow">Франшиза кофеен с пончиками</span>
      <h1 id="hero-title">
        Маленькая точка.
        <br />
        Большая амбиция.
      </h1>
      <p class="hero-lede">
        <BrandText text="39 donuts выросли из первой кофейни площадью 39 м² — и продолжают двигаться от локальной идеи к мировой сети." />
      </p>
      <div class="hero-origin-inline">
        <span>Первая идея</span>
        <strong>
          <BrandText text="39 м²" />
        </strong>
        <small>старт сети · 2023</small>
      </div>
      <div class="hero-actions">
        <Button type="button" data-open-application>
          Купить франшизу
          <SiteImage
            class="button-pack-icon"
            loading="eager"
            src={`${import.meta.env.BASE_URL}assets/icons/shop.svg`}
            alt=""
            aria-hidden="true"
          />
        </Button>
        <a class="text-link" href="#revenue">
          Смотреть показатели
          <Icon name="SolidArrowRight" />
        </a>
      </div>
    </div>

    <div class="hero-media">
      <SiteImage class="hero-photo" loading="eager" fetchpriority="high" src={assets.hero} alt="" />
      <SiteImage class="hero-donut" loading="eager" src={assets.donut} alt="" />
      <div class="hero-origin-proof">
        <span>Первая идея</span>
        <strong>
          <BrandText text="39 м²" />
        </strong>
        <small>старт сети · 2023</small>
      </div>
    </div>

    <div class="hero-metrics" aria-label="Ключевые показатели франшизы">
      {heroMetrics.map((metric, index) => (
        <article>
          <span>0{index + 1}</span>
          <strong>{metric.value}</strong>
          <p>{metric.label}</p>
        </article>
      ))}
    </div>
  </div>
</section>

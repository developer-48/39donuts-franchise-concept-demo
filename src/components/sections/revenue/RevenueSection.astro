---
import { revenue } from './content.js'

const maximum = Math.max(...revenue.map((point) => point.numeric))
---

<section class="section revenue-section reveal" id="revenue" aria-labelledby="revenue-title">
  <div class="section-shell revenue-shell">
    <div class="section-heading split-heading section-heading-solo">
      <div>
        <span class="eyebrow">Динамика сети</span>
        <h2 id="revenue-title">Выручка по годам</h2>
      </div>
    </div>
    <div
      class="revenue-chart"
      role="img"
      aria-label="Выручка сети: 8,5 млн рублей в 2023, 96 млн в 2024 и 202,715 млн в 2025 году"
    >
      {revenue.map((point, index) => (
        <article class="revenue-point">
          <div class="revenue-meta">
            <span>{point.year}</span>
            <strong>{point.value}</strong>
          </div>
          <div class="revenue-track" aria-hidden="true">
            <span style={`--bar-size: ${Math.max(9, (point.numeric / maximum) * 100)}%`}></span>
          </div>
          <small>
            {index === 0
              ? 'точка отсчёта'
              : `≈ ${(point.numeric / revenue[index - 1].numeric).toFixed(1).replace('.', ',')}× к предыдущему году`}
          </small>
        </article>
      ))}
    </div>
  </div>
</section>

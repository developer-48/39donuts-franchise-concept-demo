---
import SiteImage from '../../ui/image/SiteImage.astro'
import { formats } from './content.js'
import BrandText from '../../ui/brand/BrandText.astro'
---

<section class="section formats-section reveal" id="formats" aria-labelledby="formats-title">
  <div class="section-shell">
    <div class="section-heading split-heading section-heading-solo">
      <div>
        <span class="eyebrow">Выберите модель</span>
        <h2 id="formats-title">Три формата кофейни</h2>
      </div>
    </div>
    <div class="format-tabs" role="tablist" aria-label="Форматы кофеен" style="--active-format: 0">
      <span class="format-moving-selection" aria-hidden="true"></span>
      {formats.map((item, index) => (
        <button
          id={`format-tab-${item.id}`}
          type="button"
          role="tab"
          data-format-index={index}
          aria-label={`${String(index + 1).padStart(2, '0')}. ${item.name}${item.note ? `, ${item.note}` : ''}`}
          aria-selected={index === 0}
          aria-controls="format-panel"
          tabindex={index === 0 ? 0 : -1}
          class={index === 0 ? 'is-active' : ''}
        >
          <span>0{index + 1}</span>
          <span class="format-tab-label">
            <strong>{item.name}</strong>
            {item.note && <small>{item.note}</small>}
          </span>
        </button>
      ))}
    </div>
    <div
      class="format-panel format-panel-details"
      id="format-panel"
      role="tabpanel"
      aria-labelledby={`format-tab-${formats[0].id}`}
      tabindex="0"
    >
      <div class="format-visual">
        {formats.map((item, index) => (
          <SiteImage
            class={index === 0 ? 'is-active' : undefined}
            src={item.image}
            alt={index === 0 ? `${item.name}${item.note ? `, ${item.note}` : ''}` : ''}
            aria-hidden={index !== 0}
            data-format-image={index}
            data-format-alt={`${item.name}${item.note ? `, ${item.note}` : ''}`}
          />
        ))}
        <span class="asset-note" data-format-asset-note hidden>
          Визуализация формата с текущего сайта
        </span>
      </div>
      {formats.map((format, index) => (
        <div class="format-copy" data-format-copy={index} hidden={index !== 0}>
          <div class={`format-title-row format-title-row-${format.id}`}>
            <div>
              <span>Выбранный формат</span>
              <h3>
                <BrandText text={format.name} />
              </h3>
            </div>
            {format.note && <p>{format.note}</p>}
          </div>
          <dl class="format-facts format-facts-grid">
            {format.facts.map((fact, factIndex) => (
              <div class={`format-fact format-fact-${factIndex + 1}`}>
                <span class="format-fact-index" aria-hidden="true">
                  0{factIndex + 1}
                </span>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </div>
</section>

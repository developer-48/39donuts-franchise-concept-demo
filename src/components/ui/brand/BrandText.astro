---
const { text = '' } = Astro.props
const parts = text.split(/(39\s?donuts|39\s?м(?:²|2))/gi)
---

{parts.map((part) => {
  const brandMatch = part.match(/^(39)(\s?)(donuts)$/i)

  if (brandMatch) {
    return (
      <span class="brand-name">
        <span class="brand-name-number">{brandMatch[1]}</span>
        {brandMatch[2]}
        <span class="brand-name-word">{brandMatch[3]}</span>
      </span>
    )
  }

  if (/^39\s?м(?:²|2)$/i.test(part)) {
    return <span class="brand-area">{part}</span>
  }

  return part
})}
